# Copiar a .env y ajustar (no commitear .env)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=cerebro
DB_PASSWORD=cambiar
DB_NAME=cerebro_operativo
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=24h
PORT=3000
ALLOWED_EMAIL_DOMAIN=miempresa.com
SEED_ADMIN_EMAIL=admin@miempresa.com
SEED_ADMIN_PASSWORD=cambiar
OLLAMA_BASE_URL=http://localhost:11434
# RAG: cualquier modelo. Modo "lectura repo" (herramientas): usá uno con tool calling, p. ej. llama3.1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Git: clon/pull (repos privados con PAT; no se guarda en la app)
# Con `docker compose`, el backend carga este archivo (env_file) — pone el token acá.
# GIT_PERSONAL_ACCESS_TOKEN=ghp_...
# GIT_CLONE_BASE_PATH=./.cerebro-git-workspaces
# ALLOW_ABSOLUTE_LOCAL_REPO=true
